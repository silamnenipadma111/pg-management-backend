# Copy to /opt/pg-management/pg-management.env and fill in real values (never commit the real file).
SPRING_PROFILES_ACTIVE=oracle
PORT=8080
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=pg_management
ORACLE_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
# Your GoDaddy domain(s) that serve the Angular site
CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com
UPLOAD_DIR=/opt/pg-management/uploads
SEED_MOCK_DATA=false
