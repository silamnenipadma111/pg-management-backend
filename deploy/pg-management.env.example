# Copy to /opt/pg-management/pg-management.env and fill in real values (never commit the real file).
SPRING_PROFILES_ACTIVE=oracle
PORT=8080
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=pg_management
ORACLE_PASSWORD=change-me
# Your GoDaddy domain(s) that serve the Angular site
CORS_ALLOWED_ORIGINS=https://pg-stay.in,https://www.pg-stay.in
# Base URL of the website, used for the links in emails (verify email, reset password, view booking)
PUBLIC_URL=https://pg-stay.in
UPLOAD_DIR=/opt/pg-management/uploads
SEED_MOCK_DATA=false

# --- Email: the business mailbox that sends account / booking emails and receives enquiries ---
SUPPORT_EMAIL=support@pg-stay.in
# SMTP server of the mail provider that hosts support@pg-stay.in (see the SMTP settings page of the provider)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=support@pg-stay.in
MAIL_PASSWORD=
MAIL_FROM=support@pg-stay.in

# --- Sign-in security (the defaults are production ready) ---
# The session cookie is HttpOnly + Secure + SameSite=Strict; keep SECURE=true whenever the site runs on HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Strict
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=2h
# auto = new accounts must confirm their email whenever MAIL_HOST is set
REQUIRE_EMAIL_VERIFICATION=auto
